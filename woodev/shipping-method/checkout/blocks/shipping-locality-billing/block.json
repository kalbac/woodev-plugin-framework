{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "woodev/shipping-locality-billing",
	"version": "1.0.0",
	"title": "Delivery locality",
	"description": "Lets the shopper pick a locality from the location provider and fills in the city and region.",
	"category": "woocommerce",
	"supports": {
		"align": false,
		"html": false,
		"multiple": false,
		"reusable": false,
		"inserter": false,
		"lock": false
	},
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		}
	},
	"parent": [ "woocommerce/checkout-billing-address-block" ],
	"textdomain": "woodev-plugin-framework"
}
