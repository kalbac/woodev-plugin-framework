# Normalize line endings for all text files
* text=auto

# PHP, JS, and config files — enforce LF
*.php text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Git hooks — enforce LF, because a CRLF hook is broken in WSL and only LOOKS fine on
# Windows. Measured s122: git-bash tolerates `#!/usr/bin/env sh` + CRLF and runs the hook,
# while the same file under WSL dies with `set: Illegal option -` — the  joins the option.
# This box has `core.autocrlf=true`, so without this rule any FRESH checkout of a hook lands
# as CRLF; `commit-msg` reads LF today only because it has not been re-checked-out since it
# was written. Issue #802.
.githooks/** text eol=lf

# Built front-end assets — enforce LF so a Windows rebuild matches the
# Linux CI build-parity check byte-for-byte.
woodev/assets/build/** text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.ico binary
