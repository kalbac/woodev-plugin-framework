# Normalize line endings for all text files
* text=auto

# PHP, JS, and config files — enforce LF
*.php text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Git hooks — enforce LF. A CRLF hook is broken under WSL and only LOOKS fine on Windows:
# measured s122, git-bash tolerates a CRLF `#!/usr/bin/env sh` and runs the hook, while the
# same file under WSL dies with `set: Illegal option -` because the carriage return joins
# the option. This box has `core.autocrlf=true`, so without this rule a FRESH checkout of a
# hook lands as CRLF; `commit-msg` reads LF today only because it has not been re-checked-out
# since it was written. `.gitattributes` pins itself for the same reason. Issue #802.
*.sh text eol=lf
.githooks/** text eol=lf
.gitattributes text eol=lf

# Built front-end assets — enforce LF so a Windows rebuild matches the
# Linux CI build-parity check byte-for-byte.
woodev/assets/build/** text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.ico binary
