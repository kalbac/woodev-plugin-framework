<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
		 bootstrap="tests/bootstrap.php"
		 colors="true"
		 executionOrder="depends,defects"
		 beStrictAboutOutputDuringTests="true"
		 beStrictAboutTodoAnnotatedTests="true"
		 failOnRisky="true"
		 failOnWarning="true">

	<!-- =====================================================
		 Test Suites
	====================================================== -->
	<testsuites>

		<!-- Юнит тесты: без WordPress, с Brain Monkey -->
		<testsuite name="Unit">
			<directory suffix="Test.php">./tests/unit</directory>
		</testsuite>

		<!-- Интеграционные тесты: внутри wp-env с реальным WordPress -->
		<testsuite name="Integration">
			<directory suffix="Test.php">./tests/integration</directory>
		</testsuite>

	</testsuites>

	<!-- A finished unit test lets go of its own properties (#1842): PHPUnit keeps every test object
		 alive until the end of the run, and fakes held in them cost ~50 MB on the marketplace tests alone. -->
	<listeners>
		<listener class="Woodev\Tests\Unit\Support\Test_Properties_Releaser"/>
	</listeners>

	<!-- =====================================================
		 Coverage: какой код измеряем
		 Указываем папку фреймворка ./woodev
	====================================================== -->
	<coverage>
		<include>
			<directory suffix=".php">./woodev</directory>
		</include>
		<exclude>
			<!-- Исключаем файлы которые не нужно покрывать тестами -->
			<directory>./woodev/assets</directory>
			<directory>./woodev/languages</directory>
		</exclude>
	</coverage>

	<!-- =====================================================
		 PHP INI настройки для тестов
	====================================================== -->
	<php>
		<ini name="display_errors" value="1"/>
		<ini name="error_reporting" value="-1"/>

		<!-- #632 / #1842. The ceiling is explicit so that a RED run prints its failures instead of
			 dying on a limit that happens to be lower on this machine. On a red run PHPUnit also holds
			 the error objects, hits the ceiling, and dies with a fatal inside Patchwork instead of
			 printing them — the symptom hides the cause (s102: 268 errors from a WC() stub leaking
			 process-wide, and the first thing the run showed was a fatal in someone else's library).
			 Invisible in CI, which is the point: setup-php sets memory_limit=-1 there.

			 Measured on PHP 7.4 in #1842 (18.11.2026, 10 787 tests): the green run peaks at ~450 MB
			 (~520 MB before the listener above freed finished tests). ~220 MB of it is already there when the
			 first test starts (most likely the whole suite, Patchwork-instrumented, compiled while PHPUnit
			 builds it); the rest is class code PHP never gives back (Mockery's generated mock
			 classes, framework classes loaded on first use). 512M left no room at all: the run died
			 in the result-cache write at 99 %. A red run costs nothing measurable more (40 errors vs none
			 stayed inside the run-to-run noise of a few MB), so the ceiling needs headroom for growth
			 of the suite, not for errors: 1G is ~2.2x today's peak, and
			 still a real ceiling — a runaway test dies at 1 GB, not at the machine's. -->
		<ini name="memory_limit" value="1G"/>
	</php>

</phpunit>
